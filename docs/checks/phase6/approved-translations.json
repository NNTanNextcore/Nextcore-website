  {
    "id": 54,
    "source": "Những chia sẻ thực tế từ khách hàng đang đồng hành cùng Nextcore.",
    "translation": "Real experiences shared by clients working with Nextcore.",
    "context": "`nc_testimonials_intro`"
  },
  {
    "id": 55,
    "source": "Công ty An Tâm Việt",
    "translation": "Công ty An Tâm Việt",
